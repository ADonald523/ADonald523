rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Profil : chacun ne lit et n'écrit que le sien.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /budgets/{budgetId} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function sizeOk() { return request.resource.data.json.size() < 1000000; }

      allow read: if isMember();

      // Création : on en est l'unique membre.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid] && sizeOk();

      allow update: if
        // Un membre modifie les données ou crée un lien d'invitation.
        (isMember() && changed().hasOnly(['json', 'updatedAt', 'inviteToken']) && sizeOk())
        // Rejoindre avec un jeton d'invitation valide (2 personnes max par budget).
        || (signedIn()
            && !(request.auth.uid in resource.data.members)
            && resource.data.inviteToken is string
            && request.resource.data.joinWith == resource.data.inviteToken
            && changed().hasOnly(['members', 'joinWith'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.size() <= 2)
        // Quitter le budget.
        || (isMember()
            && changed().hasOnly(['members'])
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && !(request.auth.uid in request.resource.data.members));

      allow delete: if isMember() && resource.data.members.size() == 1;
    }
  }
}
